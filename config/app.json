      "isms": {
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "mcp-remote",
          "https://isms-mcp.sslwireless.com/mcp"
        ]
      },
      "sequential-thinking": {
        "transport": "stdio",
        "command": "npx",
        "args": [
