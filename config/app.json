    "commands": {
      "allow": [
        "aside",
        "build-fix",
        "checkpoint",
        "evolve",
        "fastapi-review",
        "feature-dev",
        "multi-backend",
        "multi-execute",
        "multi-frontend",
        "multi-plan",
        "multi-workflow",
        "orch-add-feature",
        "orch-change-feature",
