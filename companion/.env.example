# Copy to .env and set the URL of your a770 server manager.
A770_SERVER_URL=http://127.0.0.1:8000

# The URL the app UI is served from. Only needed in dev, where Vite serves
# the React app on 5173 while the API stays on 8000: the companion window
# loads this URL, and the session/CSRF cookies and the server-origin check
# (companion/main.js isServerUrl) need it. Unset -> A770_SERVER_URL.
A770_FRONTEND_URL=http://localhost:5173

# What the environment of an agent-written shell/git command may see.
#   deny  (default, unset) only the build-critical names (PATH, HOME, TEMP, ...)
#   allow               only the names named in COMPANION_ENV_ALLOW
# NOTE: in allow mode the build-critical names are dropped too, so re-list
# them: COMPANION_ENV_ALLOW=PATH,HOME,SystemRoot,TEMP,...
COMPANION_ENV_POLICY=deny

# Names re-admitted individually, on top of either policy. Comma separated.
# The deny mode exists because every secret in the session environment
# (cloud keys, GITHUB_TOKEN, DB passwords) used to be readable by the code
# the model writes.
COMPANION_ENV_ALLOW=GITHUB_TOKEN