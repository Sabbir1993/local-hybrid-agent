{
  "name": "local-agent",
  "version": "0.2.103",
  "description": "Local companion for Local Agent — runs file/shell operations on your own machine on the server's behalf.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-icon": "node build-icon.js",
    "dist": "node build-icon.js && electron-builder"
  },
  "author": "SSLWIRELESS",
  "build": {
    "appId": "com.local-agent.companion",
    "productName": "Local Agent",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "SERVER_URL/companion-updates/"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "dotenv": "^9.0.2",
    "electron-updater": "^6.1.7",
    "playwright-core": "^1.63.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
