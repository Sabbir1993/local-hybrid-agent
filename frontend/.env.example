# Application Identity
VITE_PROJECT_NAME="Vulkan Arc"
VITE_APP_DESCRIPTION="A770 Dual-Runtime Workstation & Multi-Agent Environment"
VITE_APP_VERSION="1.0.0"

# Server & Endpoints
VITE_API_BASE_URL=""
VITE_WS_URL=""

# Logging Configuration
# Options: debug | info | warn | error | none
VITE_LOG_LEVEL="debug"
VITE_LOG_MAX_BUFFER="500"
VITE_LOG_REMOTE_SYNC="false"

# Feature Flags
VITE_ENABLE_VOICE="true"
VITE_ENABLE_MEDIA_LANES="true"
VITE_ENABLE_MCP="true"
VITE_ENABLE_CLAUDE_DOCK="true"

# Organization email domain: login and "create user" take only the part before @ and append this
VITE_ORG_DOMAIN="example.com"
